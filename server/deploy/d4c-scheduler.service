[Unit]
Description=Run due D4C scheduled Codex turns
After=d4c-codex.service
Requires=d4c-codex.service

[Service]
Type=oneshot
User=d4c
Group=d4c
UMask=0077
ExecStart=/usr/local/libexec/d4c-scheduler tick
TimeoutStartSec=20min
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/d4c/schedules
BindReadOnlyPaths=/tmp/codex-daemon-@D4C_UID@
RestrictAddressFamilies=AF_UNIX
