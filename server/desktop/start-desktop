#!/bin/bash
set -eu
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
# VNC is reachable only through the manager's private, loopback-published port.
# Each container has its own X server, bus, home and network namespace.
Xvnc :1 -geometry "${D4C_WIDTH:-1280}x${D4C_HEIGHT:-800}" -depth 24 -rfbport 5900 -SecurityTypes None -localhost no -AlwaysShared -AcceptSetDesktopSize=1 &
vnc_pid=$!
trap 'kill "$vnc_pid" 2>/dev/null || true' EXIT
for attempt in {1..50}; do
    xdpyinfo -display :1 >/dev/null 2>&1 && break
    kill -0 "$vnc_pid" 2>/dev/null || exit 1
    sleep 0.1
done
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
dbus-run-session -- startxfce4 &
xfce_pid=$!
trap 'kill "$xfce_pid" "$vnc_pid" 2>/dev/null || true' EXIT
wait -n "$vnc_pid" "$xfce_pid"
